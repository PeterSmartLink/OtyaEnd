{
  "name": "otya-system-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "predev": "npm run sync:brand",
    "dev": "next dev",
    "prebuild": "npm run sync:brand",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "validate:config": "node validate-config.mjs",
    "verify:migrations": "node scripts/verify-migration-layout.mjs",
    "check": "npm run validate:config && npm run verify:migrations && npm test && npm run typecheck",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "prepreview": "npm run sync:brand",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "predeploy": "npm run sync:brand && npm run verify:migrations && npx wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/ensure-admin-session-secret.mjs && opennextjs-cloudflare build && node scripts/deploy-core-version.mjs && node scripts/verify-admin-mfa.mjs",
    "maintenance:edge-csp": "bash scripts/remove-legacy-edge-csp.sh",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.5.5",
    "clsx": "^2.1.1",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
